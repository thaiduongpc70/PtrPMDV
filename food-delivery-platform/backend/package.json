{
  "name": "food-delivery-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend Node.js cho Food Delivery Management System",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node scripts/check-syntax.mjs",
    "seed:real": "node scripts/seed-realistic.mjs",
    "seed:demo": "node scripts/seed-realistic.mjs",
    "test": "node --import ./scripts/setup-test-env.mjs --test",
    "test:coverage": "node --experimental-test-coverage --import ./scripts/setup-test-env.mjs --test",
    "smoke": "node scripts/smoke.mjs",
    "db:backup": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/backup-db.ps1",
    "db:restore:test": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/restore-test.ps1",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.7"
  }
}
