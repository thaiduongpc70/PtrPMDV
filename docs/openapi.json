{
  "openapi": "3.0.3",
  "info": {
    "title": "Food Delivery API",
    "version": "0.9.0",
    "description": "API for customer ordering, restaurant operations, shipper delivery, payments and administration."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "tags": [
    { "name": "Health" },
    { "name": "Auth" },
    { "name": "Catalog" },
    { "name": "Jobs" },
    { "name": "Delivery" },
    { "name": "Payments" },
    { "name": "Communication" }
  ],
  "paths": {
    "/health/live": { "get": { "tags": ["Health"], "responses": { "200": { "description": "Service is alive" } } } },
    "/health/ready": { "get": { "tags": ["Health"], "responses": { "200": { "description": "Database is ready" }, "503": { "description": "Database is unavailable" } } } },
    "/api/auth/login": { "post": { "tags": ["Auth"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } }, "responses": { "200": { "description": "JWT session" }, "401": { "description": "Invalid credentials" } } } },
    "/api/auth/me": { "get": { "tags": ["Auth"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Current user" } } } },
    "/api/docs": { "get": { "tags": ["Health"], "responses": { "200": { "description": "Swagger UI" } } } },
    "/api/openapi.json": { "get": { "tags": ["Health"], "responses": { "200": { "description": "OpenAPI contract" } } } },
    "/api/catalog/restaurants": { "get": { "tags": ["Catalog"], "parameters": [{ "name": "keyword", "in": "query", "schema": { "type": "string" } }, { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }], "responses": { "200": { "description": "Restaurant page" } } } },
    "/api/catalog/menu-items": { "get": { "tags": ["Catalog"], "responses": { "200": { "description": "Menu item page" } } } },
    "/api/jobs/imports": { "post": { "tags": ["Jobs"], "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportRequest" } } } }, "responses": { "201": { "description": "Import result" } } }, "get": { "tags": ["Jobs"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Import jobs" } } } },
    "/api/jobs/exports": { "post": { "tags": ["Jobs"], "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Export job" } } }, "get": { "tags": ["Jobs"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Export jobs" } } } },
    "/api/shippers/assignments": { "get": { "tags": ["Delivery"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Assignments" } } } },
    "/api/shippers/locations": { "post": { "tags": ["Delivery"], "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "GPS point" } } } },
    "/api/payments/orders/{orderId}": { "get": { "tags": ["Payments"], "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "orderId", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Payments" } } } },
    "/api/communications/chat/sessions": { "get": { "tags": ["Communication"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Chat sessions" } } }, "post": { "tags": ["Communication"], "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Chat session" } } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "schemas": {
      "Error": { "type": "object", "required": ["message"], "properties": { "message": { "type": "string" } } },
      "Job": { "type": "object", "properties": { "id": { "type": "integer" }, "status": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" } } },
      "LoginRequest": { "type": "object", "required": ["emailOrUsername", "password"], "properties": { "emailOrUsername": { "type": "string" }, "password": { "type": "string", "format": "password" } } },
      "ImportRequest": { "type": "object", "required": ["jobType", "content"], "properties": { "jobType": { "type": "string", "enum": ["MENU_ITEMS", "RESTAURANTS"] }, "format": { "type": "string", "enum": ["CSV", "EXCEL"], "description": "EXCEL accepts SpreadsheetML .xls/.xml text in this offline build." }, "fileName": { "type": "string" }, "content": { "type": "string" } } }
    }
  }
}
